{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Type-check only. Vite builds the app into client/dist, so tsc must never write there.
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
  },
  "include": ["src"],
  "references": [{ "path": "../engine" }]
}
