{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://riftbound-rules/card-schema.json",
  "title": "CardDef",
  "type": "object",
  "required": ["cardId", "name", "type", "cost"],
  "additionalProperties": false,
  "definitions": {
    "costCardChoice": {
      "description": "A cost that needs the payer to choose cards (R46): discard from hand, kill / exhaust / return friendly permanents, recycle from the Trash.",
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["DISCARD", "KILL", "EXHAUST", "RETURN", "RECYCLE", "SPEND_BUFF", "REVEAL"] },
        "count": { "type": "integer", "minimum": 2 },
        "what": { "enum": ["unit", "gear", "unitOrGear", "spell"] },
        "here": { "type": "boolean" },
        "another": { "type": "boolean" },
        "mighty": { "type": "boolean" },
        "hidden": { "type": "boolean" },
        "minEnergy": { "type": "integer", "minimum": 0 },
        "subtype": { "type": "string" }
      }
    }
  },
  "properties": {
    "cardId": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string" },
    "type": { "enum": ["UNIT", "SPELL", "GEAR", "LEGEND", "RUNE", "BATTLEFIELD", "TOKEN"] },
    "subtypes": { "type": "array", "items": { "type": "string" } },
    "cost": {
      "type": "object",
      "required": ["energy"],
      "additionalProperties": false,
      "properties": {
        "energy": { "type": "integer", "minimum": 0 },
        "power": { "type": "integer", "minimum": 0 },
        "domain": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["element", "amount"],
            "additionalProperties": false,
            "properties": {
              "element": { "enum": ["Fury", "Calm", "Mind", "Body", "Chaos", "Order"] },
              "amount": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "domains": {
      "type": "array",
      "items": { "enum": ["Fury", "Calm", "Mind", "Body", "Chaos", "Order"] }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "might": { "type": "integer" },
        "health": { "type": "integer" }
      }
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "enum": [
              "Action",
              "Reaction",
              "Tank",
              "Backline",
              "Assault",
              "Shield",
              "Ganking",
              "Accelerate",
              "Temporary",
              "Hidden",
              "Deflect",
              "Unique",
              "Equip",
              "QuickDraw",
              "Deathknell",
              "Legion",
              "Ambush",
              "Level",
              "Hunt",
              "Flow",
              "Repeat",
              "Predict",
              "ShowOff",
              "Weaponmaster",
              "Empower",
              "Deploy",
              "Vision",
              "Disarm"
            ]
          },
          "value": { "type": "integer" }
        }
      }
    },
    "text": { "type": "string" },
    "supportLevel": { "enum": ["full", "partial"] },
    "effects": { "type": "array", "items": { "type": "object" } },
    "triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "optional": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "energy": { "type": "integer", "minimum": 1 },
              "power": { "type": "integer", "minimum": 1 },
              "anyPower": { "type": "integer", "minimum": 1 },
              "burn": { "type": "integer", "minimum": 1 },
              "exhaustSelf": { "type": "boolean" },
              "xp": { "type": "integer", "minimum": 1 },
              "killSelf": { "type": "boolean" },
              "mandatory": { "type": "boolean" },
              "card": { "$ref": "#/definitions/costCardChoice" }
            }
          }
        }
      }
    },
    "abilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cost": {
            "type": "object",
            "properties": { "card": { "$ref": "#/definitions/costCardChoice" } }
          }
        }
      }
    },
    "entersReady": { "type": "boolean" },
    "uncounterable": { "type": "boolean" },
    "ignoreDeflect": { "type": "boolean" },
    "entersReadyWhen": { "type": "object" },
    "entersExhausted": { "type": "boolean" },
    "legionCostReduction": { "type": "integer", "minimum": 0 },
    "equipCost": { "type": "object" },
    "repeatCost": {
      "type": "object",
      "properties": { "card": { "$ref": "#/definitions/costCardChoice" } }
    },
    "additionalCost": {
      "description": "A required additional cost to play the card (R47).",
      "type": "object",
      "required": ["card"],
      "additionalProperties": false,
      "properties": { "card": { "$ref": "#/definitions/costCardChoice" } }
    },
    "playTo": {
      "description": "Extra battlefields a Unit may be played to (R76).",
      "type": "array",
      "items": { "enum": ["OPEN", "ENEMY"] }
    },
    "flowCost": {
      "description": "Flow: the spell may be played from the Trash for this cost, then banished (R61).",
      "type": "object",
      "required": ["energy"],
      "additionalProperties": false,
      "properties": {
        "energy": { "type": "integer", "minimum": 0 },
        "power": { "type": "integer", "minimum": 1 },
        "anyPower": { "type": "integer", "minimum": 1 }
      }
    },
    "modes": {
      "description": "Modal spell: the effects of each mode (Choose one), R59.",
      "type": "array",
      "minItems": 2,
      "items": { "type": "array", "items": { "type": "object" } }
    },
    "optionalAdditionalCost": {
      "description": "You may pay this as an additional cost to play the card (R58).",
      "type": "object",
      "required": ["energy"],
      "additionalProperties": false,
      "properties": {
        "energy": { "type": "integer", "minimum": 0 },
        "power": { "type": "integer", "minimum": 1 },
        "anyPower": { "type": "integer", "minimum": 1 },
        "card": { "$ref": "#/definitions/costCardChoice" },
        "xp": { "type": "integer", "minimum": 1 },
        "reduceEnergy": { "type": "integer", "minimum": 1 },
        "reduceAll": { "type": "boolean" }
      }
    },
    "costReduction": {
      "description": "Self cost reduction: I cost [N] less for each / if ... (R50).",
      "type": "object",
      "required": ["energy"],
      "properties": {
        "energy": { "type": "integer", "minimum": 1 },
        "per": { "type": "string" },
        "when": { "type": "object" },
        "min": { "type": "integer", "minimum": 0 }
      }
    },
    "statics": {
      "description": "Static abilities: grants of Might / keywords to some units or gear (R51).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["affects"],
        "properties": {
          "affects": { "type": "string" },
          "subtype": { "type": "string" },
          "when": { "type": "object" },
          "might": { "type": "integer" },
          "keywords": { "type": "array", "items": { "type": "object" } }
        }
      }
    },
    "imageUrl": { "type": "string" }
  }
}
