{
  "name": "riftbound-rules",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "engine",
    "client"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check:rules": "node scripts/check-rule-citations.mjs",
    "cards": "tsx scripts/fetch-cards.ts && tsx scripts/build-cards.ts",
    "dev": "npm run dev -w client"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
